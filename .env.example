# Environment Configuration for VentureIQ

# Backend Settings
PROJECT_NAME="VentureIQ"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
# For local development with docker: postgresql+asyncpg://ventureiq_user:ventureiq_pass@localhost:5432/ventureiq_db
DATABASE_URL="sqlite+aiosqlite:///./ventureiq.db"
SYNC_DATABASE_URL="sqlite:///./ventureiq.db"

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"


# Frontend Public Environment Variables
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
